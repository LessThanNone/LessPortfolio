<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1920 1080" width="100%" height="100%">
  <defs>
    <!-- Rich Deep Plum & Violet-Black Canvas -->
    <linearGradient id="athosBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#140620" />
      <stop offset="35%" stop-color="#2B0C3E" />
      <stop offset="70%" stop-color="#480355" />
      <stop offset="100%" stop-color="#180824" />
    </linearGradient>

    <!-- Electric Cyan Atmospheric Glow -->
    <radialGradient id="cyanAmbient" cx="45%" cy="40%" r="55%">
      <stop offset="0%" stop-color="#90FCF9" stop-opacity="0.3" />
      <stop offset="45%" stop-color="#63B4D1" stop-opacity="0.14" />
      <stop offset="100%" stop-color="#140620" stop-opacity="0" />
    </radialGradient>

    <!-- Amethyst Purple Warm Glow -->
    <radialGradient id="amethystAmbient" cx="75%" cy="65%" r="50%">
      <stop offset="0%" stop-color="#9448BC" stop-opacity="0.32" />
      <stop offset="50%" stop-color="#480355" stop-opacity="0.15" />
      <stop offset="100%" stop-color="#180824" stop-opacity="0" />
    </radialGradient>
  </defs>

  <!-- Solid Dark Contrast Base -->
  <rect width="1920" height="1080" fill="url(#athosBg)" />
  <rect width="1920" height="1080" fill="url(#cyanAmbient)" />
  <rect width="1920" height="1080" fill="url(#amethystAmbient)" />

  <!-- Minimal Architectural Gridlines -->
  <g stroke="rgba(255, 255, 255, 0.05)" stroke-width="1">
    <line x1="0" y1="270" x2="1920" y2="270" />
    <line x1="0" y1="540" x2="1920" y2="540" />
    <line x1="0" y1="810" x2="1920" y2="810" />
    <line x1="480" y1="0" x2="480" y2="1080" />
    <line x1="960" y1="0" x2="960" y2="1080" />
    <line x1="1440" y1="0" x2="1440" y2="1080" />
  </g>

  <!-- Athos Decorative Astrolabe Geometry -->
  <circle cx="960" cy="540" r="340" fill="none" stroke="rgba(144, 252, 249, 0.16)" stroke-width="1.5" stroke-dasharray="6 8" />
  <circle cx="960" cy="540" r="500" fill="none" stroke="rgba(148, 72, 188, 0.14)" stroke-width="1" />
  <circle cx="960" cy="540" r="180" fill="none" stroke="rgba(255, 255, 255, 0.2)" stroke-width="1" />
</svg>
